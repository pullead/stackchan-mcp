+namespace {
+
+// -- 设备端动作序列 ------------------------------------------------
+//
+// 为什么放在设备上跑：PC 侧逐条发 set_head_angles 做不出快节奏动作。
+// 设备开了 WiFi 省电，密集请求时延迟会累积恶化——实测「点头 3 下、间隔
+// 0.25 秒」预期 1.5 秒，实际 9 秒且逐次变慢。动作在本地跑就没这个问题。
+//
+// 工具回调跑在主线程（app.Schedule），不能在里面阻塞几秒，否则音频和
+// 协议都会卡。所以起一个任务执行，工具立即返回。
+
+enum class MotionKind { Nod, Shake, LookAround };
+
+struct MotionJob {
+    MotionKind kind;
+    int times;
+    int amplitude;  // 度
+    int speed;
+};
+
+std::atomic<bool> g_motion_busy{false};
+
+// head_pet.h 里用的自然活动范围，单位 0.1 度
+constexpr int kPitchRawMin = 0;
+constexpr int kPitchRawMax = 540;
+constexpr int kYawRawMin   = -512;
+constexpr int kYawRawMax   = 512;
+
+int clamp_i(int v, int lo, int hi)
+{
+    return v < lo ? lo : (v > hi ? hi : v);
+}
+
+// 下发目标并等舵机走到目标附近。
+//
+// 注意不能等 motion.isMoving() 变 false：底层是弹簧动画（smooth_ui_toolkit
+// spring），渐近收敛、尾巴很长，等它彻底静止每段要 1 秒以上，3 下点头会拖到
+// 10 秒。点头要的是「到了极点就反向」，所以按位置容差判断，走到附近就继续。
+void move_and_settle(int yaw_raw, int pitch_raw, int speed, int timeout_ms, int tol_raw)
+{
+    yaw_raw   = clamp_i(yaw_raw, kYawRawMin, kYawRawMax);
+    pitch_raw = clamp_i(pitch_raw, kPitchRawMin, kPitchRawMax);
+
+    {
+        LvglLockGuard lock;
+        GetStackChan().motion().moveWithSpeed(yaw_raw, pitch_raw, speed);
+    }
+
+    int waited = 0;
+    while (waited < timeout_ms) {
+        vTaskDelay(pdMS_TO_TICKS(15));
+        waited += 15;
+
+        int cy, cp;
+        {
+            LvglLockGuard lock;
+            auto& motion = GetStackChan().motion();
+            cy           = motion.yawServo().getCurrentAngle();
+            cp           = motion.pitchServo().getCurrentAngle();
+        }
+        if (abs(cy - yaw_raw) <= tol_raw && abs(cp - pitch_raw) <= tol_raw) {
+            return;
+        }
+    }
+}
+
+void motion_task(void* arg)
+{
+    std::unique_ptr<MotionJob> job(static_cast<MotionJob*>(arg));
+
+    int yaw0, pitch0;
+    {
+        LvglLockGuard lock;
+        auto& motion = GetStackChan().motion();
+        yaw0         = motion.yawServo().getCurrentAngle();
+        pitch0       = motion.pitchServo().getCurrentAngle();
+    }
+
+    const int amp = job->amplitude * 10;  // 度 -> 0.1 度
+    const int spd = job->speed;
+    // 容差取幅度的 1/4，够接近极点就反向，不等弹簧收尾
+    const int tol   = amp / 4 > 15 ? amp / 4 : 15;
+    const int64_t t0 = esp_timer_get_time();
+
+    switch (job->kind) {
+        case MotionKind::Nod:
+            for (int i = 0; i < job->times; i++) {
+                move_and_settle(yaw0, pitch0 - amp, spd, 700, tol);
+                move_and_settle(yaw0, pitch0 + amp, spd, 700, tol);
+            }
+            move_and_settle(yaw0, pitch0, spd, 700, tol);
+            break;
+
+        case MotionKind::Shake:
+            for (int i = 0; i < job->times; i++) {
+                move_and_settle(yaw0 - amp, pitch0, spd, 700, tol);
+                move_and_settle(yaw0 + amp, pitch0, spd, 700, tol);
+            }
+            move_and_settle(yaw0, pitch0, spd, 700, tol);
+            break;
+
+        case MotionKind::LookAround:
+            for (int i = 0; i < job->times; i++) {
+                move_and_settle(yaw0 - amp, pitch0, spd, 1200, tol);
+                vTaskDelay(pdMS_TO_TICKS(600));
+                move_and_settle(yaw0 + amp, pitch0, spd, 1200, tol);
+                vTaskDelay(pdMS_TO_TICKS(600));
+            }
+            move_and_settle(yaw0, pitch0, spd, 1200, tol);
+            break;
+    }
+
+    mclog::tagInfo(_tag, "motion done in {} ms", (int)((esp_timer_get_time() - t0) / 1000));
+
+    g_motion_busy.store(false);
+    vTaskDelete(nullptr);
+}
+
+// 返回 true 表示已排上，false 表示上一个动作还没做完
+bool start_motion(MotionKind kind, int times, int amplitude, int speed)
+{
+    bool expected = false;
+    if (!g_motion_busy.compare_exchange_strong(expected, true)) {
+        return false;
+    }
+    auto* job = new MotionJob{kind, times, amplitude, speed};
+    if (xTaskCreatePinnedToCore(motion_task, "sc_motion", 4096, job, 4, nullptr, 1) != pdPASS) {
+        delete job;
+        g_motion_busy.store(false);
+        return false;
+    }
+    return true;
+}
+
+// show_text 的气泡不会自己消失，这里用一个一次性定时器到点清空。
+// 小智助手说话时的气泡是它自己管理的，不受影响。
+esp_timer_handle_t g_speech_clear_timer = nullptr;
+
+void speech_clear_cb(void*)
+{
+    auto display = Board::GetInstance().GetDisplay();
+    if (display != nullptr) {
+        display->SetChatMessage("assistant", "");
+    }
+}
+
+void schedule_speech_clear(int seconds)
+{
+    if (g_speech_clear_timer == nullptr) {
+        esp_timer_create_args_t args = {
+            .callback              = speech_clear_cb,
+            .arg                   = nullptr,
+            .dispatch_method       = ESP_TIMER_TASK,
+            .name                  = "speech_clear",
+            .skip_unhandled_events = true,
+        };
+        esp_timer_create(&args, &g_speech_clear_timer);
+    }
+    esp_timer_stop(g_speech_clear_timer);
+    if (seconds > 0) {
+        esp_timer_start_once(g_speech_clear_timer, (uint64_t)seconds * 1000000ULL);
+    }
+}
