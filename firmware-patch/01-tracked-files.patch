+void StackChanAvatarDisplay::SuppressIdleExpression(int seconds)
+{
+    auto& stackchan = GetStackChan();
+
+    if (idle_expr_resume_timer_ != nullptr) {
+        esp_timer_stop(idle_expr_resume_timer_);
+    }
+
+    DisplayLockGuard lock(this);
+
+    if (seconds <= 0) {
+        // 恢复。只有小智确实处于 idle 时才补回去，否则交给正常的状态切换逻辑，
+        // 避免在非 idle 状态下凭空挂上一个待机动画。
+        if (hal_bridge::is_xiaozhi_idle() && idle_expression_modifier_id_ < 0) {
+            idle_expression_modifier_id_ = stackchan.addModifier(std::make_unique<IdleExpressionModifier>());
+        }
+        return;
+    }
+
+    if (idle_expression_modifier_id_ >= 0) {
+        stackchan.removeModifier(idle_expression_modifier_id_);
+        idle_expression_modifier_id_ = -1;
+    }
+
+    if (idle_expr_resume_timer_ == nullptr) {
+        esp_timer_create_args_t args = {
+            .callback =
+                [](void* arg) {
+                    static_cast<StackChanAvatarDisplay*>(arg)->SuppressIdleExpression(0);
+                },
+            .arg                   = this,
+            .dispatch_method       = ESP_TIMER_TASK,
+            .name                  = "idle_expr_resume",
+            .skip_unhandled_events = true,
+        };
+        esp_timer_create(&args, &idle_expr_resume_timer_);
+    }
+    esp_timer_start_once(idle_expr_resume_timer_, (uint64_t)seconds * 1000000ULL);
+}
