+                               return false;
+                           }
+                           display->SetEmotion(emotion.c_str());
+
+                           // 不摘掉待机表情动画的话，IdleExpressionModifier 每 2-6 秒就会
+                           // 改动五官、并有 20% 概率 reset_to_neutral()，表情活不过几秒。
+                           auto* sc = static_cast<StackChanAvatarDisplay*>(display);
+                           sc->SuppressIdleExpression(hold);
+
+                           return true;
+                       });
+
+    mclog::tagInfo(_tag, "add robot.show_text tool");
+    mcp_server.AddTool("self.robot.show_text",
+                       "Show a short line of text in the robot's speech bubble. "
+                       "Keep it brief; long text is hard to read on a 320x240 screen. "
+                       "This only draws text, it does not speak. "
+                       "The bubble clears itself after duration_seconds (default 8; 0 keeps it forever). "
+                       "Pass an empty text to clear it immediately.",
+                       PropertyList({Property("text", kPropertyTypeString, std::string("")),
+                                     Property("duration_seconds", kPropertyTypeInteger, 8, 0, 600)}),
+                       [this](const PropertyList& properties) -> ReturnValue {
+                           std::string text = properties["text"].value<std::string>();
+                           int duration     = properties["duration_seconds"].value<int>();
+
+                           mclog::tagInfo(_tag, "show_text: {} duration={}s", text, duration);
+
+                           auto display = Board::GetInstance().GetDisplay();
+                           if (display == nullptr) {
+                               return false;
+                           }
+                           display->SetChatMessage("assistant", text.c_str());
+
+                           schedule_speech_clear(text.empty() ? 0 : duration);
+
+                           return true;
+                       });
+
+    mclog::tagInfo(_tag, "add robot.nod tool");
+    mcp_server.AddTool("self.robot.nod",
+                       "Nod the head up and down. Runs on the device so the rhythm stays smooth; "
+                       "returns immediately while the motion plays out. "
+                       "Nods around the current head position and returns to it when done.",
+                       PropertyList({Property("times", kPropertyTypeInteger, 3, 1, 20),
+                                     Property("amplitude", kPropertyTypeInteger, 12, 2, 30),
+                                     Property("speed", kPropertyTypeInteger, 800, 100, 1000)}),
+                       [this](const PropertyList& properties) -> ReturnValue {
+                           int times = properties["times"].value<int>();
+                           int amp   = properties["amplitude"].value<int>();
+                           int speed = properties["speed"].value<int>();
+                           mclog::tagInfo(_tag, "nod x{} amp={} speed={}", times, amp, speed);
+                           if (!start_motion(MotionKind::Nod, times, amp, speed)) {
+                               throw std::runtime_error("Another motion is still running");
+                           }
+                           return true;
+                       });
+
+    mclog::tagInfo(_tag, "add robot.shake_head tool");
+    mcp_server.AddTool("self.robot.shake_head",
+                       "Shake the head left and right, the gesture for saying no. Runs on the device; "
+                       "returns immediately while the motion plays out. "
+                       "Shakes around the current head position and returns to it when done.",
+                       PropertyList({Property("times", kPropertyTypeInteger, 3, 1, 20),
+                                     Property("amplitude", kPropertyTypeInteger, 25, 5, 45),
+                                     Property("speed", kPropertyTypeInteger, 800, 100, 1000)}),
+                       [this](const PropertyList& properties) -> ReturnValue {
+                           int times = properties["times"].value<int>();
+                           int amp   = properties["amplitude"].value<int>();
+                           int speed = properties["speed"].value<int>();
+                           mclog::tagInfo(_tag, "shake_head x{} amp={} speed={}", times, amp, speed);
+                           if (!start_motion(MotionKind::Shake, times, amp, speed)) {
+                               throw std::runtime_error("Another motion is still running");
+                           }
+                           return true;
+                       });
+
+    mclog::tagInfo(_tag, "add robot.look_around tool");
+    mcp_server.AddTool("self.robot.look_around",
+                       "Slowly look left and right with a pause on each side, like scanning the room. "
+                       "Slower and wider than shake_head. Runs on the device, returns immediately.",
+                       PropertyList({Property("times", kPropertyTypeInteger, 1, 1, 10),
+                                     Property("amplitude", kPropertyTypeInteger, 40, 10, 50),
+                                     Property("speed", kPropertyTypeInteger, 300, 100, 1000)}),
+                       [this](const PropertyList& properties) -> ReturnValue {
+                           int times = properties["times"].value<int>();
+                           int amp   = properties["amplitude"].value<int>();
+                           int speed = properties["speed"].value<int>();
+                           mclog::tagInfo(_tag, "look_around x{} amp={} speed={}", times, amp, speed);
+                           if (!start_motion(MotionKind::LookAround, times, amp, speed)) {
+                               throw std::runtime_error("Another motion is still running");
+                           }
+                           return true;
+                       });
 }
