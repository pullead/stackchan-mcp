@@ -2,7 +2,13 @@
 # CMakeLists in this exact order for cmake to work correctly
 cmake_minimum_required(VERSION 3.16)
 
-set(PROJECT_VER "1.4.3")
+# 故意设成远高于官方的版本号，用来永久关闭小智云的自动 OTA。
+# M5Stack 开源的源码版本落后于云端发布版（1.4.3 vs 1.4.4），自建固件一联网
+# 就会被云端自动 OTA 静默覆盖掉。设高版本后 OTA 检查恒返回
+# "Current is the latest version"。
+# 代价：收不到官方固件更新。要回官方请刷 backup/ 的镜像或 M5Stack 出厂恢复
+# 固件，见 backup/RESTORE.md。
+set(PROJECT_VER "9.9.9")
 add_definitions(-DFIRMWARE_VERSION=\"${PROJECT_VER}\")
 
 # Add this line to disable the specific warning
