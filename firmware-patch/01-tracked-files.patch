+
+void schedule_speech_clear(int seconds)
+{
+    if (g_speech_clear_timer == nullptr) {
+        esp_timer_create_args_t args = {
+            .callback              = speech_clear_cb,
+            .arg                   = nullptr,
+            .dispatch_method       = ESP_TIMER_TASK,
+            .name                  = "speech_clear",
+            .skip_unhandled_events = true,
+        };
+        esp_timer_create(&args, &g_speech_clear_timer);
+    }
+    esp_timer_stop(g_speech_clear_timer);
+    if (seconds > 0) {
+        esp_timer_start_once(g_speech_clear_timer, (uint64_t)seconds * 1000000ULL);
+    }
+}
